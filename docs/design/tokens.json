{
  "schema": "flooria.design-tokens.v1",
  "referenceViewport": {
    "width": 390,
    "height": 844,
    "devicePixelRatio": 3
  },
  "theme": "sunlit pastel fantasy",
  "colors": {
    "sky": "#9FD4F8",
    "skyLight": "#DDF2FF",
    "ivory": "#FFF8EE",
    "surface": "#FFFDFC",
    "ink": "#334F78",
    "inkMuted": "#8995B1",
    "goldLight": "#FFF4BA",
    "gold": "#FFD778",
    "goldDeep": "#EAAF49",
    "sage": "#CBE4CD",
    "sageDeep": "#6F9B79",
    "lavender": "#DDD9EE",
    "lavenderDeep": "#9892AF",
    "border": "#FFFFFF",
    "danger": "#F4A3A6"
  },
  "typography": {
    "family": "rounded system sans (replace with licensed font supporting future locales)",
    "logo": "separate asset",
    "title": {
      "fontSize": 26,
      "fontWeight": 800,
      "lineHeight": 1.12
    },
    "heading": {
      "fontSize": 20,
      "fontWeight": 800,
      "lineHeight": 1.2
    },
    "body": {
      "fontSize": 15,
      "fontWeight": 600,
      "lineHeight": 1.35
    },
    "caption": {
      "fontSize": 12,
      "fontWeight": 600,
      "lineHeight": 1.25
    },
    "button": {
      "fontSize": 18,
      "fontWeight": 800,
      "lineHeight": 1.15
    }
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40
  ],
  "radius": {
    "small": 12,
    "card": 22,
    "dialog": 28,
    "pill": 999
  },
  "sizing": {
    "minTap": 48,
    "topSafeArea": "use MediaQuery",
    "bottomSafeArea": "use MediaQuery",
    "horizontalMargin": 20,
    "primaryButtonHeight": 60,
    "bottomNavigationHeight": 72,
    "iconSize": 28,
    "gameTileIcon": 82,
    "gameColumnsMobile": 3
  },
  "shadows": {
    "panel": {
      "color": "#334F78",
      "opacity": 0.13,
      "blur": 20,
      "y": 8
    },
    "floating": {
      "color": "#334F78",
      "opacity": 0.17,
      "blur": 26,
      "y": 12
    },
    "buttonBase": {
      "color": "#B77B31",
      "opacity": 0.58,
      "blur": 1,
      "y": 4
    }
  },
  "animation": {
    "pressedMs": 110,
    "fadeMs": 280,
    "towerMoveMs": 540,
    "reducedMotion": "respect accessibility settings"
  },
  "layerOrder": [
    "sky-gradient",
    "far-clouds",
    "distant-ruins",
    "tower-back",
    "tower-floor-art",
    "dynamic-floor-ui",
    "mid-clouds",
    "foreground-clouds",
    "ui-panels",
    "navigation"
  ],
  "rules": [
    "No text/numbers baked into images",
    "No screen screenshot used as an asset",
    "No hard-coded user statistics",
    "Only relevant available screens connected",
    "Use geometry/widgets for buttons and panels; raster only for visually complex material",
    "All art layers have consistent left-top lighting",
    "Screenshots must match approved viewport and be compared side-by-side"
  ]
}
